+namespace {
+// one high resolution timer for each thread that keeps time with SleepPrecise
+struct PreciseTimer {
+  HANDLE handle = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+  ~PreciseTimer() {
+    if (handle)
+      CloseHandle(handle);
+  }
+};
+}  // namespace
+
+void SleepPrecise(std::chrono::microseconds duration) {
+  using Clock = std::chrono::steady_clock;
+  const auto end = Clock::now() + duration;
+  thread_local PreciseTimer timer;
+  if (duration.count() > 800) {
+    const auto nap = duration - std::chrono::microseconds(500);
+    LARGE_INTEGER due;
+    due.QuadPart = -static_cast<LONGLONG>(nap.count()) * 10;  // 100 ns units, relative
+    if (timer.handle && SetWaitableTimerEx(timer.handle, &due, 0, nullptr, nullptr, nullptr, 0)) {
+      WaitForSingleObject(timer.handle, INFINITE);
+    } else {
+      ::Sleep(static_cast<DWORD>(nap.count() / 1000));
+    }
+  }
+  while (Clock::now() < end)
+    SwitchToThread();
+}
