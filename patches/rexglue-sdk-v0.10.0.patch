--- /dev/null
+++ b/src/graphics/shaders/resolve_unscale.cs.hlsl
@@ -0,0 +1,106 @@
+// Compute shader taking a resolve's scaled data back to 1x, into the shared memory: for each 1x pixel,
+// one of its scale_x * scale_y host pixels, or (32bpp, 8 bits per channel) the average of them all.
+// Or (corner) the 1x data of a pass drawn at 1x into its render target's top-left, a host pixel for
+// each 1x pixel: 1x pixel (x, y) of the tiled 2D rectangle the resolve wrote is the host pixel (x, y).
+//
+// The scaled resolve layout (as the resolve_*_scaled shaders write it): the 16 bytes of 1x pixels
+// that hold E = 16 / bytes per pixel of them (a 1x row's E consecutive pixels, from x0, a multiple
+// of E) take scale_x * scale_y * 16 bytes, at their 1x address times scale_x * scale_y: 16-byte
+// chunks of E host pixels, chunk j * scale_y + r holding host row r of the group, host pixels
+// scale_x * x0 + E * j to + E - 1. (Not each 1x pixel's host pixels together: that is only so for
+// 64bpp at 2x.)
+//
+// Built into bytecode/d3d12_5_1/resolve_unscale_cs.h with:
+//   fxc /nologo /T cs_5_1 /E main /O3 /Vn resolve_unscale_cs /Fh resolve_unscale_cs.h resolve_unscale.cs.hlsl
+// (then line endings made LF and trailing spaces removed, as the other headers are).
+
+cbuffer XeResolveUnscaleConstants : register(b0) {
+  uint xe_unscale_scale_x;
+  uint xe_unscale_scale_y;
+  // 2 for 32bpp, 3 for 64bpp.
+  uint xe_unscale_pixel_size_log2;
+  uint xe_unscale_pixel_count;
+  // The host pixel taken when not averaging.
+  uint xe_unscale_sample_x;
+  uint xe_unscale_sample_y;
+  // 32bpp only: each byte the average of the host pixels' (8 bits per channel).
+  uint xe_unscale_average;
+  // The corner gather: the rectangle's pitch (pixels, a multiple of 32), width and height.
+  uint xe_unscale_corner;
+  uint xe_unscale_corner_pitch;
+  uint xe_unscale_corner_width;
+  uint xe_unscale_corner_height;
+  uint xe_unscale_padding;
+};
+
+ByteAddressBuffer xe_unscale_source : register(t0);
+RWByteAddressBuffer xe_unscale_dest : register(u0);
+
+// The byte offset of a pixel in a tiled 2D surface (Xenos' tiling, as texture_util::GetTiledOffset2D).
+uint XeUnscaleTiledOffset2D(uint2 p, uint pitch, uint bpp_log2) {
+  int x = int(p.x);
+  int y = int(p.y);
+  int macro_offset = ((x >> 5) + (y >> 5) * int(pitch >> 5)) << (bpp_log2 + 7u);
+  int micro_offset = ((x & 7) + ((y & 0xE) << 2)) << bpp_log2;
+  int offset = macro_offset + ((micro_offset & ~0xF) << 1) + (micro_offset & 0xF) + ((y & 1) << 4);
+  return uint(((offset & ~0x1FF) << 3) + ((y & 16) << 7) + ((offset & 0x1C0) << 2) +
+              (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 0x3F));
+}
+
+// Where the scaled resolve put a host pixel: the group's 16 bytes at 1x (`group_address`, relative to
+// the range), the host pixel's x from the group's first host pixel, and its row within the 1x pixel.
+uint XeUnscaleScaledAddress(uint group_address, uint host_x_in_group, uint host_row) {
+  uint pixels_per_chunk_log2 = 4u - xe_unscale_pixel_size_log2;
+  uint chunk = (host_x_in_group >> pixels_per_chunk_log2) * xe_unscale_scale_y + host_row;
+  uint in_chunk = host_x_in_group & ((1u << pixels_per_chunk_log2) - 1u);
+  return group_address * (xe_unscale_scale_x * xe_unscale_scale_y) + (chunk << 4u) +
+         (in_chunk << xe_unscale_pixel_size_log2);
+}
+
+[numthreads(64, 1, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  uint pixel = xe_thread_id.x;
+  [branch] if (pixel >= xe_unscale_pixel_count) {
+    return;
+  }
+  uint pixels_per_chunk_log2 = 4u - xe_unscale_pixel_size_log2;
+  uint source;
+  uint dest;
+  [branch] if (xe_unscale_corner != 0u) {
+    uint2 p = uint2(pixel % xe_unscale_corner_width, pixel / xe_unscale_corner_width);
+    uint2 p_1x = p / uint2(xe_unscale_scale_x, xe_unscale_scale_y);
+    uint group_x = p_1x.x & ~((1u << pixels_per_chunk_log2) - 1u);
+    source = XeUnscaleScaledAddress(
+        XeUnscaleTiledOffset2D(uint2(group_x, p_1x.y), xe_unscale_corner_pitch,
+                               xe_unscale_pixel_size_log2),
+        p.x - xe_unscale_scale_x * group_x, p.y - xe_unscale_scale_y * p_1x.y);
+    dest = XeUnscaleTiledOffset2D(p, xe_unscale_corner_pitch, xe_unscale_pixel_size_log2);
+  } else {
+    // The 1x pixel's place in its group of the 16 bytes, from the group's first.
+    uint group_address = (pixel >> pixels_per_chunk_log2) << 4u;
+    uint host_x_in_group = (pixel & ((1u << pixels_per_chunk_log2) - 1u)) * xe_unscale_scale_x;
+    dest = pixel << xe_unscale_pixel_size_log2;
+    [branch] if (xe_unscale_average != 0u && xe_unscale_pixel_size_log2 == 2u) {
+      uint4 sum = uint4(0u, 0u, 0u, 0u);
+      for (uint r = 0u; r < xe_unscale_scale_y; ++r) {
+        for (uint i = 0u; i < xe_unscale_scale_x; ++i) {
+          uint value =
+              xe_unscale_source.Load(XeUnscaleScaledAddress(group_address, host_x_in_group + i, r));
+          sum += uint4(value, value >> 8u, value >> 16u, value >> 24u) & 0xFFu;
+        }
+      }
+      uint samples = xe_unscale_scale_x * xe_unscale_scale_y;
+      uint4 average = (sum + (samples >> 1u)) / samples;
+      xe_unscale_dest.Store(dest,
+                            average.x | (average.y << 8u) | (average.z << 16u) | (average.w << 24u));
+      return;
+    }
+    source = XeUnscaleScaledAddress(group_address, host_x_in_group + xe_unscale_sample_x,
+                                    xe_unscale_sample_y);
+  }
+  [branch] if (xe_unscale_pixel_size_log2 == 3u) {
+    xe_unscale_dest.Store2(dest, xe_unscale_source.Load2(source));
+  } else {
+    xe_unscale_dest.Store(dest, xe_unscale_source.Load(source));
+  }
+}
