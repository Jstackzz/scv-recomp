+  # REXGLUE_NO_PACKAGE_REGISTRY in the environment: a project's private SDK copy, which other projects on the
+  # same machine must not find through the registry
+  if(DEFINED ENV{REXGLUE_NO_PACKAGE_REGISTRY})
+    message(STATUS "Not registered in the CMake user package registry (REXGLUE_NO_PACKAGE_REGISTRY)")
+  else()
     # Normalize path casing on Windows before hashing to avoid duplicate entries
     if(CMAKE_HOST_WIN32)
         string(TOLOWER "${CMAKE_INSTALL_PREFIX}" _reg_key)
@@ -214,4 +219,5 @@ install(CODE [[
     endif()
     message(STATUS "Registered rexglue in CMake user package registry")
     message(STATUS "  -> ${CMAKE_INSTALL_PREFIX}")
+  endif()
 ]])
