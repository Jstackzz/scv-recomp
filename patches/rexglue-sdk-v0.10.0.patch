+D3D12CommandProcessor::TextureMakingResolve D3D12CommandProcessor::GetTextureMakingResolve() {
+  // Long enough for a fighter's textures, made over a few frames, and both fighters' (one after the
+  // other, frames apart); over well before the fight.
+  constexpr uint64_t kCompressionReadbackFrames = 60;
+  std::vector<uint32_t> pass_images;
+  pass_images.swap(pass_compression_images_);
+  const RegisterFile& regs = *register_file_;
+  if (regs.Get<reg::RB_COPY_DEST_INFO>().copy_dest_format ==
+          xenos::ColorFormat::k_16_16_16_16_FLOAT &&
+      !pass_images.empty()) {
+    // The blocks of a compression pass, copied into a texture.
+    if (frame_current_ >= compression_readback_until_frame_) {
+      REXGPU_INFO(
+          "Textures compressed on the GPU: resolves of the images they are made from are read back to "
+          "the CPU for {} frames",
+          kCompressionReadbackFrames);
+    }
+    compression_readback_until_frame_ = frame_current_ + kCompressionReadbackFrames;
+    for (uint32_t image : pass_images) {
+      if (std::find(compression_images_.begin(), compression_images_.end(), image) ==
+          compression_images_.end()) {
+        compression_images_.push_back(image);
+        if (compression_images_.size() > 16) {
+          compression_images_.erase(compression_images_.begin());
+        }
+      }
+    }
+    return TextureMakingResolve::kBlocks;
+  }
+  if (frame_current_ >= compression_readback_until_frame_) {
+    return TextureMakingResolve::kNone;
+  }
+  uint32_t dest_base = regs[XE_GPU_REG_RB_COPY_DEST_BASE] & 0x1FFFFFFF;
+  return std::find(compression_images_.begin(), compression_images_.end(), dest_base) !=
+                 compression_images_.end()
+             ? TextureMakingResolve::kImage
+             : TextureMakingResolve::kNone;
+}
