+// A logger that lets a repeated warning or error through the first 8 times and then at the 16th, 32nd,
+// 64th ... (with the count), and everything below warnings as ever. The logger's sinks flush every line
+// (flush_level), so a message logged per frame or per interrupt was a file write each time, 75 a second
+// from the GPU interrupt alone (a stub's warning, under the global lock that every kernel call of the
+// game's threads takes) and a few a frame from the GPU thread in some scenes. Two lines are the same
+// when they come from the same category and read the same but for their numbers (decimal digits, and hex
+// words of 6 or more digits: addresses, register dumps).
+class ThrottledLogger final : public spdlog::logger {
+ public:
+  ThrottledLogger(std::string name, std::vector<spdlog::sink_ptr>::iterator begin,
+                  std::vector<spdlog::sink_ptr>::iterator end)
+      : spdlog::logger(std::move(name), begin, end), enabled_(REXCVAR_GET(log_throttle_repeats)) {}
+
+ protected:
+  void sink_it_(const spdlog::details::log_msg& msg) override {
+    if (!enabled_ || msg.level < spdlog::level::warn || msg.level >= spdlog::level::off) {
+      spdlog::logger::sink_it_(msg);
+      return;
+    }
+    const std::string_view text(msg.payload.data(), msg.payload.size());
+    uint64_t key = 14695981039346656037ull;  // FNV-1a
+    auto mix = [&key](unsigned char c) { key = (key ^ c) * 1099511628211ull; };
+    for (char c : std::string_view(msg.logger_name.data(), msg.logger_name.size()))
+      mix(static_cast<unsigned char>(c));
+    // the text without its numbers: decimal digits, and the hex words of an address (0x82E80968) or a register dump
+    // ("880000FC 18E3B052": 6 or more hex digits, at least one of them a number)
+    for (size_t i = 0; i < text.size();) {
+      const auto is_hex = [&text](size_t at) {
+        return at < text.size() && std::isxdigit(static_cast<unsigned char>(text[at]));
+      };
+      if (is_hex(i)) {
+        size_t end = i;
+        bool number = false;
+        while (is_hex(end)) {
+          number |= text[end] >= '0' && text[end] <= '9';
+          ++end;
+        }
+        if (end - i >= 6 && number) {
+          mix('#');
+        } else {
+          for (size_t k = i; k < end; ++k) {
+            if (text[k] < '0' || text[k] > '9') mix(static_cast<unsigned char>(text[k]));
+          }
+        }
+        i = end;
+      } else {
+        mix(static_cast<unsigned char>(text[i]));
+        ++i;
+      }
+    }
+    uint32_t count;
+    {
+      std::lock_guard lock(g_repeat_mutex);
+      auto it = g_repeat_counts.find(key);
+      if (it == g_repeat_counts.end()) {
+        if (g_repeat_counts.size() >= 4096) {  // a flood of different lines: nothing to throttle by
+          spdlog::logger::sink_it_(msg);
+          return;
+        }
+        it = g_repeat_counts.emplace(key, 0).first;
+      }
+      count = ++it->second;
+    }
+    if (count <= 8) {
+      spdlog::logger::sink_it_(msg);
+    } else if ((count & (count - 1)) == 0) {
+      const std::string again_text = fmt::format("{} [the same line {} times so far]", text, count);
+      spdlog::details::log_msg again(msg.time, msg.source, msg.logger_name, msg.level, again_text);
+      again.thread_id = msg.thread_id;
+      spdlog::logger::sink_it_(again);
+    }
+  }
+
+ private:
+  bool enabled_;
+  static inline std::mutex g_repeat_mutex;
+  static inline std::unordered_map<uint64_t, uint32_t> g_repeat_counts;
