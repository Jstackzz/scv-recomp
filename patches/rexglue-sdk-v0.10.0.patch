+// (a frame's back chain at [sp], its caller's LR at [back chain - 8])
+std::vector<uint32_t> GuestCallers() {
+  std::vector<uint32_t> out;
+  auto* thread = XThread::GetCurrentThread();
+  if (!thread || !thread->thread_state()) return out;
+  const PPCContext* ctx = thread->thread_state()->context();
