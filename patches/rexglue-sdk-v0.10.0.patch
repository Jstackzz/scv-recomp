+void D3D12CommandProcessor::NoteTextureCompressionDraw(const Shader& pixel_shader) {
+  for (const Shader::TextureBinding& binding : pixel_shader.texture_bindings()) {
+    uint32_t base =
+        (uint32_t(register_file_->GetTextureFetch(binding.fetch_constant).base_address) << 12) &
+        0x1FFFFFFF;
+    if (base && std::find(pass_compression_images_.begin(), pass_compression_images_.end(), base) ==
+                    pass_compression_images_.end()) {
+      pass_compression_images_.push_back(base);
+    }
+  }
