diff --git a/include/rex/kernel/xam/ui.h b/include/rex/kernel/xam/ui.h
new file mode 100644
index 0000000..fbda782
--- /dev/null
+++ b/include/rex/kernel/xam/ui.h
@@ -0,0 +1,33 @@
+#pragma once
+/**
+ * What a game can do about the system UI the runtime shows for it.
+ *
+ * @modified    SC5 Online, 2026 - a game's own answers to its message boxes
+ */
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam {
+
+// A message box the game asks for (XamShowMessageBoxUI)
+struct MessageBoxRequest {
+  uint32_t user_index = 0;
+  std::string title;
+  std::string text;
+  std::vector<std::string> buttons;
+  uint32_t active_button = 0;
+  // the guest's return addresses at the call, innermost first (up to 16): which of the game's functions asked
+  std::vector<uint32_t> callers;
+};
+
+// Asked before a message box is shown: the button to choose (the box is not shown, and the game gets that button as
+// if the player had picked it), or nothing to show the box as usual. Set once, before the game runs; called on the
+// game's thread.
+using MessageBoxAnswer = std::function<std::optional<uint32_t>(const MessageBoxRequest&)>;
+void SetMessageBoxAnswer(MessageBoxAnswer answer);
+
+}  // namespace rex::kernel::xam
